{
  "name": "OFM Engine — CAPI retry (dead jobs)",
  "nodes": [
    {
      "id": "b5c5e253-4d1e-5ec3-bcea-d693c83ebdf9",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "ccdebe22-3b70-556b-b5d1-8d269906c880",
      "name": "List dead CAPI jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{($env.OFM_BASE_URL || 'http://localhost:8000')}}/api/v1/automations/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "dead"
            },
            {
              "name": "kind",
              "value": "meta_capi.send"
            },
            {
              "name": "limit",
              "value": "50"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "OFM_API_KEY",
          "name": "OFM Engine API key (X-API-Key)"
        }
      }
    },
    {
      "id": "3f552d62-1af6-5730-831f-6625f603158f",
      "name": "Split jobs",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      }
    },
    {
      "id": "c50755dd-23c4-557b-bbee-7cd1a1511b3f",
      "name": "Skip permanent validation errors",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "1ad3f3c0-9cb2-5c84-af88-2d665b678a62",
              "leftValue": "={{$json.last_error}}",
              "rightValue": "PermanentJobError",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            }
          ]
        }
      }
    },
    {
      "id": "770d4b00-58a3-57f0-bcee-009a08da0b4c",
      "name": "Retry job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{($env.OFM_BASE_URL || 'http://localhost:8000')}}/api/v1/automations/jobs/{{$json.id}}/retry",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "OFM_API_KEY",
          "name": "OFM Engine API key (X-API-Key)"
        }
      }
    }
  ],
  "connections": {
    "Every 30 minutes": {
      "main": [
        [
          {
            "node": "List dead CAPI jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List dead CAPI jobs": {
      "main": [
        [
          {
            "node": "Split jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split jobs": {
      "main": [
        [
          {
            "node": "Skip permanent validation errors",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Skip permanent validation errors": {
      "main": [
        [
          {
            "node": "Retry job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false,
  "tags": [
    {
      "name": "ofm-engine"
    }
  ]
}
