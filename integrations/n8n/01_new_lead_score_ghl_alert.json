    {
      "id": "dcfeb60f-22d4-5c1d-892c-9bfaf75ed9c0",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Verify X-OFM-Signature (t=<unix>,v1=<hmac_sha256(secret, t + '.' + rawBody)>) and reject replays (>300s).\nconst crypto = require('crypto');\nconst secret = $env.OFM_WEBHOOK_SECRET;\nconst item = $input.first();\nconst header = item.json.headers['x-ofm-signature'] || '';\nconst parts = Object.fromEntries(header.split(',').map(p => p.trim().split('=')));\nconst raw = item.binary && item.binary.data ? Buffer.from(item.binary.data.data, 'base64').toString('utf8') : JSON.stringify(item.json.body);\nconst expected = crypto.createHmac('sha256', secret).update(parts.t + '.' + raw).digest('hex');\nconst age = Math.abs(Date.now() / 1000 - Number(parts.t));\nif (!parts.v1 || age > 300 || !crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(parts.v1))) {\n  throw new Error('invalid or replayed OFM webhook');\n}\nconst body = JSON.parse(raw);\nreturn [{ json: body }];"
      }
    },
    {
