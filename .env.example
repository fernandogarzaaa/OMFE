# OFM Engine — copy to .env. Every value is optional in development (mock mode).
ENV=development
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./ofm_engine.db
# DATABASE_URL=postgresql://ofm:ofm@localhost:5432/ofm
# REDIS_URL=redis://localhost:6379/0
RUN_WORKER_IN_PROCESS=true
# --- required in production (generate: `ofm gen-key`, `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
# JWT_SECRET=
# MASTER_KEYS=newest-key,older-key
# PII_HASH_SALT=
# METRICS_TOKEN=
# CORS_ORIGINS=https://app.example.com
# --- integrations stay in mock mode until credentials are pasted in Settings > Integrations
# OUTBOUND_WEBHOOKS_LIVE=false
# LLM_PROVIDER=mock
